#!/bin/sh
# Refuse to publish commits that carry game data or decompiler output (ADR-0009). Installed by
# `git config core.hooksPath scripts/hooks` (docs/build.md). Reads the ref updates git passes on stdin.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    if git rev-parse --verify --quiet origin/main >/dev/null; then range="origin/main..$local_sha"; fi
  else
    range="$remote_sha..$local_sha"
  fi
  python scripts/check_no_assets.py --range "$range" || status=1
done
exit $status
